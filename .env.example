# Environment Variables Configuration Template
# Copy this file to .env before starting services

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_APP_TITLE="Maharashtra Government Schemes Assistant"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Backend Configuration (FastAPI)
PROJECT_NAME="Maharashtra Government Schemes API"
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./scheme_assistant.db

# AI & RAG Configuration (Phase 4)
# LLM Provider selection: 'mock' (default, deterministic offline rules for tests & local dev) or 'openai' (production live)
LLM_PROVIDER=mock

# OpenAI Configuration (Required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30.0
