# ==============================================================================
# Government Schemes and Scholarships Assistant - Environment Template
# Copy to .env in backend/ or root directory. NEVER commit actual secret values.
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Configuration (Next.js)
NEXT_PUBLIC_APP_TITLE="Maharashtra Government Schemes Assistant"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Backend Configuration (FastAPI)
PROJECT_NAME="Maharashtra Government Schemes API"
# In production, generate a secure 64-char key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,frontend,backend

# Relational Database (PostgreSQL for containerized/prod, SQLite for local dev)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./scheme_assistant.db

# Docker Compose DB Credentials
POSTGRES_DB=schemedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_INTERVAL=15

# AI & RAG Configuration (Phase 4)
# LLM Provider: 'mock' (offline deterministic rules) or 'openai' (production live)
LLM_PROVIDER=mock

# OpenAI Configuration (Required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30.0
