# Environment Variables Configuration Template
# Copy this file to .env before starting services

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_APP_TITLE="Government Scheme Assistant"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Backend Configuration (FastAPI)
PROJECT_NAME="Government Scheme Assistant API"
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scheme_assistant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
DATABASE_URL=postgresql://postgres:postgres_password_change_me@localhost:5432/scheme_assistant_db

# AI & RAG Configuration (Phase 3+)
LLM_PROVIDER=mock # mock | openai | azure | local
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
